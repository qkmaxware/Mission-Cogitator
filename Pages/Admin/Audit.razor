                }
            }
        }*/
        
        this.missingLinks = results;
    }
    private static bool IsInsideCorrectLink(
        string content,
        int matchIndex,
        string? targetId,
        string? targetName)
    {
        if (targetId is null || targetName is null)
            return false;

        var linkPattern =
            $@"<see\s+cref\s*=\s*['""]{Regex.Escape(targetId)}['""]\s*>\s*{Regex.Escape(targetName)}\s*</see>";

        foreach (Match linkMatch in Regex.Matches(
                     content,
                     linkPattern,
                     RegexOptions.IgnoreCase))
        {
            if (matchIndex >= linkMatch.Index &&
                matchIndex < linkMatch.Index + linkMatch.Length)
            {
                return true;
            }
        }

        return false;
    }

    private class BrokenLink {
        public IPackagedContent? Source {get; set;}
        public string? LinkId { get; set; }
        public int Position { get; set; }
    }
    private List<BrokenLink>? brokenLinks;
    public void FindBrokenLinks() {
        FindBrokenLinks(
            ruledb.AllRules.Cast<IPackagedContent>()
            .Concat(teamdb.AllTeams.Cast<IPackagedContent>())
            .Concat(teamdb.AllTeams.SelectMany(t => t.Units ?? Enumerable.Empty<Unit>()).Distinct().Cast<IPackagedContent>())

            .Where(item => item.SourcePackage?.Name is null || package_filter is null || item.SourcePackage.Name.Contains(package_filter, StringComparison.CurrentCultureIgnoreCase))
        );
    }

    private static readonly Regex SEE_PATTERN = new Regex(@"<\s*see\s+cref=['""](?<id>[^'""]*)['""]\s*>", RegexOptions.Compiled);
    public void FindBrokenLinks(IEnumerable<IPackagedContent> pages) {
        List<BrokenLink> results = new ();

        foreach (var page in pages) {
            if (page.Description is null)
                continue;

            foreach (Match match in SEE_PATTERN.Matches(page.Description)) {
                if (!match.Success)
                    continue;
                if (!match.Groups.ContainsKey("id"))
                    continue;
                
                var id = match.Groups["id"].Value;
                Rule? matched = ruledb.GetValue(id);

                if (matched is not null)
                    continue;

                results.Add(new BrokenLink {
                    Source = page,
                    LinkId = id,
                    Position = match.Index
                });
            }
        }

        this.brokenLinks = results;
    }
    
}