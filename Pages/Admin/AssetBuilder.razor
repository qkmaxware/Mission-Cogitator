@page "/admin/builder"

@using Kt.Data
@using Kt.Data.IO
@using Kt.Data.JsInterop
@using Kt.Layout.Editing
@using System.Reflection
@using System.Text.RegularExpressions
@using System.IO.Compression
@using System.Text.Json
@using Kt.Layout.QualityAssurance

@inject IJSRuntime js
@inject JsPrompt prompt
@inject RuleDatabase ruledb

<Modal @ref=qa_modal Title=@qa_title Options=@Modal.Buttons.Cancel>
    @switch (qa_current_tool) {
        case QATools.Bolding:
            <BoldingReview Package=@pkg></BoldingReview>
            break;
        case QATools.Autolink:
            <AutolinkReview Package=@pkg></AutolinkReview> 
            break;
        case QATools.BrokenLinks:
            <BrokenLinkReview Package=@pkg></BrokenLinkReview> 
            break;
    }
</Modal>
@code {
    private enum QATools {
        Bolding, Autolink, BrokenLinks
    }
    private string qa_title = "Quality Assurance";
    private QATools qa_current_tool;
    private Modal? qa_modal;

    private async Task ShowQA(QATools tool) {
        this.qa_current_tool = tool;
        this.qa_title = "Quality Assurance - " + tool.ToString();
        if (qa_modal is null)
            return;
        await qa_modal.Show(); 
    }
}

<div class="w3-padding">

<section>
    <header>Package Info</header>
    <div class="w3-margin-top w3-padding">
        <label>Name: </label>
        <input class="w3-input" @bind=@pkg.Name/>
        <br />
        <label>Author: </label>
        <input class="w3-input" @bind=@pkg.Author/>

        <div class="w3-row" style="padding-top: 6px;">
            <div class="w3-col s6" style="padding-right: 6px;">
                <label for="pgk-import" class="w3-button app-primary" style="width: 100%;">
                    Import
                    <InputFile OnChange="loadpkg" id="pgk-import" accept=".zip" style="display: none;"/>
                </label>
            </div>
            <div class="w3-col s6" style="padding-left: 6px;">
                <button class="w3-button app-primary" style="width: 100%;" @onclick=Pack>Export</button>
            </div>
        </div>
    </div>
</section>

<section>
    <header>Quality Assurance</header>
    <div class="w3-margin-top w3-padding">
        <button class="w3-button app-primary" @onclick=@(async () => await ShowQA(QATools.Bolding))>Bolding Checker</button>
        <button class="w3-button app-primary" @onclick=@(async () => await ShowQA(QATools.Autolink))>Autolinker</button>
        <button class="w3-button app-primary" @onclick=@(async () => await ShowQA(QATools.BrokenLinks))>Broken Links</button>
    </div>
</section>

<div class="w3-row">
    <div class="w3-col" style="width: 240px; padding-right: 6px;">
        <section>
            <header>Content</header>
            <div class="w3-margin-top w3-bar-block">
                @foreach (var item in pkg.Provides()) {
                    var self = item;
                    <div class="w3-row">
                        <div class="w3-col" style="width: 2.5em;">
                            <button class="w3-button w3-bar-item" @onclick=@(async () => { if (await prompt.ConfirmAsync("Are you sure you wish to delete this resource? Some links may break if deleted.")){ Delete(self); } })>x</button>
                        </div>
                        <div class="w3-rest">
                            <button class="w3-button w3-bar-item @(IsSelected(self) ? "app-primary" : string.Empty)" @onclick=@(() => selectedObject = self)>@self.Name <small><i>@self.GetType().Name</i></small></button>
                        </div>
                    </div>
                }
                <hr />
                <div class="w3-row">
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Rule>() ?? selectedObject)>+ Definition</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Action>() ?? selectedObject)>+ Action</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Effect>() ?? selectedObject)>+ Effect</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Ploy>() ?? selectedObject)>+ Ploy</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Equipment>() ?? selectedObject)>+ Equipment</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Unit>() ?? selectedObject)>+ Unit</button>
                    <button class="w3-button w3-half" style="text-align: left;" @onclick=@(async () => selectedObject = await Add<Kt.Data.Team>() ?? selectedObject)>+ Team</button>
                </div>
            </div>
        </section>
    </div>
    <div class="w3-rest">
        <section>
            <header>Selected Item: @(selectedObject?.Name ?? "NULL")</header>
            <div class="w3-margin-top">
                @if (selectedObject is not null) {
                <label for="name">Unique Id:</label>
                <input id="name" class="w3-input" value=@selectedObject?.Id disabled>
                <label for="name">Name:</label>
                <input id="name" class="w3-input" @bind=name>
                @*Type specific stuff starts here*@
                {
                    if (selectedObject is Kt.Data.Action action) {
                        <label for="ap">AP Cost:</label>
                        <input id="ap" class="w3-input" @bind=@action.Ap>
                    } else if (selectedObject is Kt.Data.Effect effect) {

                    } else if (selectedObject is Kt.Data.Equipment equipment) {

                    } else if (selectedObject is Kt.Data.Ploy ploy) {
                        <label for="kind">Kind:</label>
                        <select class="w3-select" @bind=@ploy.Kind>
                            @foreach (var option in Enum.GetValues<PloyKind>()) {
                                <option>@option</option>
                            }
                        </select>
                    } else if (selectedObject is Kt.Data.Unit unit) {
                        unit.Attributes = unit.Attributes ?? new UnitAttributes();
                        unit.Weapons = unit.Weapons ?? new List<Weapon>();
                        unit.Rules = unit.Rules ?? new List<string>();
                        unit.Tags = unit.Tags ?? new List<string>();

                        <label for="rules">Flavour Text:</label>
                        <input id="name" class="w3-input" @bind=unit.FlavourText>

                        <label for="attributes">Attributes:</label>
                        <table id="attributes" class="w3-table">
                            <thead>
                                <th>APL</th>
                                <th>MOVE</th>
                                <th>SAVE</th>
                                <th>WOUNDS</th>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <input type="number" class="w3-input" @bind=@unit.Attributes.Apl/>
                                    </td>
                                    <td>
                                        <input type="number" class="w3-input" @bind=@unit.Attributes.Move/>
                                    </td>
                                    <td>
                                        <input type="number" class="w3-input" @bind=@unit.Attributes.Save/>
                                    </td>
                                    <td>
                                        <input type="number" class="w3-input" @bind=@unit.Attributes.Wounds/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <label for="tags">Tags:</label>
                        <ListEditor TItem=string Items=unit.Tags OnAdd="@(() => { unit.Tags.Add(string.Empty); })" OnSubtract="@(() => { if (unit.Tags.Count > 0) { unit.Tags.RemoveAt(unit.Tags.Count - 1); }})" OnDelete="@((index) => unit.Tags?.RemoveAt(index.GetOffset(unit.Tags?.Count ?? 0)))">
                            <Template>
                                <input type="text" class="w3-input" @bind=unit.Tags[context.Index]>
                            </Template>
                        </ListEditor>

                        <label for="weapons">Weapons:</label>
                        <table id="weapons" class="w3-table">
                            <thead>
                                <th>NAME</th>
                                <th>KIND</th>
                                <th>ATK</th>
                                <th>HIT</th>
                                <th>DMG (normal)</th>
                                <th>DMG (crit)</th>
                                <th>WRs</th>
                            </thead>
                            <tbody>
                                @foreach (var row in unit.Weapons) {
                                    var weapon = row;
                                    weapon.Damage = weapon.Damage ?? new Damage();

                                    <tr>
                                        <td>
                                            <input type="text" class="w3-input" @bind=@weapon.Name/>
                                        </td>
                                        <td>
                                            <select class="w3-select" @bind=@weapon.Kind>
                                                @foreach (var opt in Enum.GetValues<WeaponKind>()) {
                                                    <option>@opt</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" class="w3-input" @bind=@weapon.Atk/>
                                        </td>
                                        <td>
                                            <input type="number" class="w3-input" @bind=@weapon.Hit/>
                                        </td>
                                        <td>
                                            <input type="number" class="w3-input" @bind=@weapon.Damage.Normal/>
                                        </td>
                                        <td>
                                            <input type="number" class="w3-input" @bind=@weapon.Damage.Critical/>
                                        </td>
                                        <td>
                                            @{ weapon.Rules = weapon.Rules ?? new List<WeaponRule>(); }
                                            <table class="w3-table" style="margin-top: -20px;">
                                                <thead>
                                                    <th style="width: 8em; font-weight: normal; padding: 0; text-align: center;">Prefix</th>
                                                    <th style="width: 10em; font-weight: normal; padding: 0; text-align: center;">Id</th>
                                                    <th style="width: 5em; font-weight: normal; padding: 0; text-align: center;">X</th>
                                                    <th style="width: 8em; font-weight: normal; padding: 0; text-align: center;">Suffix</th>
                                                </thead>
                                                <tbody>
                                                @foreach (var wr in weapon.Rules) {
                                                    var rule = wr;
                                                    <tr>
                                                        <td style="padding-top: 0; padding-bottom: 0;"><input type="text" class="w3-input" @bind=@rule.Prefix/></td>
                                                        <td style="padding-top: 0; padding-bottom: 0;">
                                                            <select class="w3-select" @bind=@rule.Id>
                                                                @foreach (var r in CoreWeaponRules) {
                                                                    <option value="@r.Id">@r.Name</option>
                                                                }
                                                                @foreach (var r in (pkg.Definitions?.Values ?? Enumerable.Empty<Rule>())) {
                                                                    <option value="@r.Id">@r.Name</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td style="padding-top: 0; padding-bottom: 0;"><input type="number" class="w3-input" @bind=@rule.X/></td>
                                                        <td style="padding-top: 0; padding-bottom: 0;"><input type="text" class="w3-input" @bind=@rule.Suffix/></td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                            <div class="w3-center">
                                                <button class="w3-button app-primary" @onclick=@(() => { weapon.Rules.Add(new WeaponRule()); })>+</button>
                                                <button class="w3-button app-primary" @onclick=@(() => { if (weapon.Rules.Count > 0) { weapon.Rules.RemoveAt(weapon.Rules.Count - 1); }})>-</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="w3-center">
                            <button class="w3-button app-primary" @onclick=@(() => { unit.Weapons.Add(new Weapon() { Rules = new() }); })>+</button>
                            <button class="w3-button app-primary" @onclick=@(() => { if (unit.Weapons.Count > 0) { unit.Weapons.RemoveAt(unit.Weapons.Count - 1); }})>-</button>
                        </div>

                        <label for="rules">Special Rules/Actions:</label>
                        <ol id="rules">
                            @for (var i = 0; i < unit.Rules.Count; i++) {
                                var ruleIndex = i;
                                var ruleId = unit.Rules[i];
                                var rule = pkg.GetPackagedContent(ruleId);
                                <li>
                                    <div class="w3-col w3-right" style="width: 3em">
                                        <button class="w3-button" @onclick=@(() => unit.Rules.RemoveAt(ruleIndex))>x</button>
                                    </div>
                                    <div class="w3-rest app-panel">
                                        <button class="w3-button" style="width: 100%; text-align: left;" @onclick=@(() => selectedObject = rule)>@(rule?.Name ?? ruleId)</button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <details>
                            <summary>Add Special Rule</summary>
                            <button class="w3-button" @onclick=@(async () => { Kt.Data.Action? u = await Add<Kt.Data.Action>(); if (u is not null){ unit.Rules.Add(u.Id ?? string.Empty); selectedObject = u; }})>Create New Action</button>
                        @foreach (var factOption in DefinitionsAndActions) {
                            var self = factOption;
                            if (factOption.Id is not null && !unit.Rules.Contains(factOption.Id)) {
                                <button class="w3-button" @onclick=@(() => { unit.Rules.Add(factOption.Id); })>+ @self.Name</button>
                            }
                        }
                        </details>
                    } else if (selectedObject is Kt.Data.Team team) {
                        team.FactionRules = team.FactionRules ?? new List<Rule>();
                        team.Ploys = team.Ploys ?? new List<Ploy>();
                        team.Equipment = team.Equipment ?? new List<Equipment>();
                        team.Units = team.Units ?? new List<Unit>();

                        <label for="faction">Faction:</label>
                        <select id="faction" class="w3-select" @bind=team.Faction>
                            <option></option>
                            <option>Imperium of Man</option>
                            <option>Aeldari</option>
                            <option>Drukhari</option>
                            <option>Tyranids</option>
                            <option>Genestealer Cults</option>
                            <option>Leagues of Votann</option>
                            <option>Necrons</option>
                            <option>Orks</option>
                            <option>T'Au Empire</option>
                            <option>Unknown</option>
                            <option>Other</option>
                        </select>
                        <label for="faction-rules">Faction Rules:</label>
                        <ol id="faction-rules">
                            @for (var i = 0; i < team.FactionRules.Count; i++) {
                                var ruleIndex = i;
                                var rule = team.FactionRules[i];
                                <li>
                                    <div class="w3-col w3-right" style="width: 3em">
                                        <button class="w3-button" @onclick=@(() => team.FactionRules.RemoveAt(ruleIndex))>x</button>
                                    </div>
                                    <div class="w3-rest app-panel">
                                        <button class="w3-button" style="width: 100%; text-align: left;" @onclick=@(() => selectedObject = rule)>@(rule.Name)</button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <details>
                            <summary>Add Faction Rule to Team</summary>
                            <button class="w3-button" @onclick=@(async () => { Rule? u = await Add<Rule>(); if (u is not null){ addFactionRuleToTeam(team, u); selectedObject = u; }})>Create New Faction Rule</button>
                        @foreach (var factOption in DefinitionsAndActions) {
                            var self = factOption;
                            if (team.FactionRules is null || !team.FactionRules.Contains(factOption)) {
                                <button class="w3-button" @onclick=@(() => addFactionRuleToTeam(team, self))>+ @self.Name</button>
                            }
                        }
                        </details>
                        <label for="ploys">Ploys:</label>
                        <ol id="ploys">
                            @for (var i = 0; i < team.Ploys.Count; i++) {
                                var ruleIndex = i;
                                var rule = team.Ploys[i];
                                <li>
                                    <div class="w3-col w3-right" style="width: 3em">
                                        <button class="w3-button" @onclick=@(() => team.Ploys.RemoveAt(ruleIndex))>x</button>
                                    </div>
                                    <div class="w3-rest app-panel">
                                        <button class="w3-button" style="width: 100%; text-align: left;" @onclick=@(() => selectedObject = rule)>@(rule.Name)</button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <details>
                            <summary>Add Ploy to Team</summary>
                            <button class="w3-button" @onclick=@(async () => { Ploy? u = await Add<Ploy>(); if (u is not null){ addPloyToTeam(team, u); selectedObject = u; }})>Create New Ploy</button>
                        @foreach (var ployOption in (pkg.Ploys?.Values ?? Enumerable.Empty<Ploy>())) {
                            var self = ployOption;
                            if (team.Ploys is null || !team.Ploys.Contains(ployOption)) {
                                <button class="w3-button" @onclick=@(() => addPloyToTeam(team, self))>+ @ployOption.Name</button>
                            }
                        }
                        </details>
                        <label for="equipment">Equipment:</label>
                        <ol id="equipment">
                            @for (var i = 0; i < team.Equipment.Count; i++) {
                                var ruleIndex = i;
                                var rule = team.Equipment[i];
                                <li>
                                    <div class="w3-col w3-right" style="width: 3em">
                                        <button class="w3-button" @onclick=@(() => team.Equipment.RemoveAt(ruleIndex))>x</button>
                                    </div>
                                    <div class="w3-rest app-panel">
                                        <button class="w3-button" style="width: 100%; text-align: left;" @onclick=@(() => selectedObject = rule)>@(rule.Name)</button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <details>
                            <summary>Add Equipment to Team</summary>
                            <button class="w3-button" @onclick=@(async () => { Equipment? u = await Add<Equipment>(); if (u is not null){ addEquipToTeam(team, u); selectedObject = u; }})>Create New Equipment</button>
                        @foreach (var eqOption in (pkg.Equipment?.Values ?? Enumerable.Empty<Equipment>())) {
                            var self = eqOption;
                            if (team.Equipment is null || !team.Equipment.Contains(eqOption)) {
                                <button class="w3-button" @onclick=@(() => addEquipToTeam(team, self))>+ @eqOption.Name</button>
                            }
                        }
                        </details>
                        <label for="units">Units:</label>
                        <ol id="equipment">
                            @for (var i = 0; i < team.Units.Count; i++) {
                                var ruleIndex = i;
                                var rule = team.Units[i];
                                <li>
                                    <div class="w3-col w3-right" style="width: 3em">
                                        <button class="w3-button" @onclick=@(() => team.Units.RemoveAt(ruleIndex))>x</button>
                                    </div>
                                    <div class="w3-rest app-panel">
                                        <button class="w3-button" style="width: 100%; text-align: left;" @onclick=@(() => selectedObject = rule)>@(rule.Name)</button>
                                    </div>
                                </li>
                            }
                        </ol>
                        <details>
                            <summary>Add Unit to Team</summary>
                            <button class="w3-button" @onclick=@(async () => { Unit? u = await Add<Unit>(); if (u is not null){ addUnitToTeam(team, u); selectedObject = u; }})>Create New Unit</button>
                        @foreach (var unitOption in (pkg.Units?.Values ?? Enumerable.Empty<Unit>())) {
                            var self = unitOption;
                            if (team.Units is null || !team.Units.Contains(unitOption)) {
                                <button class="w3-button" @onclick=@(() => addUnitToTeam(team, self))>+ @unitOption.Name</button>
                            }
                        }
                        </details>
                    }
                }
                }
                @*Type specific stuff ends here*@
                <div>&nbsp;</div>
                <div class="@(selectedObject is null ? "w3-hide" : "w3-show")">
                <label for="description">Description:</label>
                <div class="w3-row-padding">
                    <div class="w3-half">
                        <span for="description">Markup:</span>
                        <div style="overflow-x: auto; whitespace: nowrap; margin-bottom: 2px;">
                            <button class="w3-button bordered border-primary" title="Add quote" @onclick=@(async () => await insertIntoDescription(templates["quote"]))><img class="icon" src="art/blockquote.svg"/></button>
                            <button class="w3-button bordered border-primary" title="Add list" @onclick=@(async () => await insertIntoDescription(templates["ul"]))><img class="icon" src="art/list-plain.svg"/></button>
                            <button class="w3-button bordered border-primary" title="Add usage list" @onclick=@(async () => await insertIntoDescription(templates["usage"]))><img class="icon" src="art/list.svg"/></button>
                            <button class="w3-button bordered border-primary" title="Add section" @onclick=@(async () => await insertIntoDescription(templates["section"]))><img class="icon" src="art/section.svg"/></button>
                            <button class="w3-button bordered border-primary" title="Add paragraph" @onclick=@(async () => await insertIntoDescription(templates["paragraph"]))><img class="icon" src="art/paragraph.svg"/></button>
                            <div style="display: inline-block" class="bordered border-primary">
                            <select @bind=linkedRule @bind:after=setRuleName class="w3-select" style="width: 12em; margin-bottom: 0;">
                                @foreach (var action in DefinitionsAndActions) {
                                    <option value="@action.Id">@action.Name</option>
                                }
                                @foreach (var r in CoreActions) {
                                    <option value="@r.Id">@r.Name</option>
                                }
                                @foreach (var r in CoreDefinitions) {
                                    <option value="@r.Id">@r.Name</option>
                                }
                                @foreach (var r in CoreWeaponRules) {
                                    <option value="@r.Id">@r.Name</option>
                                }
                                @foreach (var r in UniversalEquipment) {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                            <button class="w3-button" @onclick=@(async () => await insertIntoDescription(templates["seelink"].Replace("%cref%", linkedRule).Replace("%name%", linkedRuleName)))><img class="icon" src="art/link.svg"/></button>
                            </div>
                            <button class="w3-button bordered border-primary" @onclick=StateHasChanged><img src="art/reload.svg" class="icon"/></button>
                        </div>
                        <textarea @ref=descriptionTextArea id="description" @bind=description @bind:event="oninput" @onkeydown=descriptionListen></textarea>
                    </div>
                    <div class="w3-half">
                        <span for="description">Preview:</span>
                        <div style="height: 3em;">

                        </div>
                        <div class="w3-border">
                        @RenderDescription(description)
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </section>
    </div>
</div>

    @code {
        private Pkg pkg = new Pkg {
        Name = "New Package",
        Author = Environment.UserName,
        Updated = DateTime.Now.ToString("dd/MM/yyyy")
    };
        private static readonly Type pkgType = typeof(Pkg);

        private IPackagedContent? selectedObject;

        private Rule[] CoreWeaponRules = new Rule[0];
        private Rule[] CoreActions = new Rule[0];
        private Rule[] CoreDefinitions = new Rule[0];
        private Rule[] UniversalEquipment = new Rule[0];

        private ElementReference? descriptionTextArea;

        private string? linkedRule;
        private string? linkedRuleName;
        private void setRuleName() {
            if (linkedRule is null)
                return;

            linkedRuleName = pkg.GetPackagedContent(linkedRule)?.Name ?? ruledb.GetValue(linkedRule)?.Name ?? "Rule Name";
        }
        private Dictionary<string, string> templates = new Dictionary<string, string>{
        {"quote", 
@"<blockquote>

</blockquote>"
        },
        {"usage", 
@"<ul class='usage-bullet'>
    <li>
        Usage
    </li>
</ul>
<ul class='condition-bullet'>
    <li>
        Condition
    </li>
</ul>"
        },
        {"ul",
@"<ul>
    <li>
        List Item
    </li>
</ul>"
        },
        {"section", 
@"<section>
    <header>Title</header>
    <p>
        Content
    </p>
</section>"
        },
        {"seelink",
@"<see cref='%cref%'>%name%</see>"
        },
        {"paragraph",
@"<p>
    <b>Title: </b> Content
</p>"
        }
    };

    protected override void OnInitialized() {
        CoreActions = ruledb.GetCoreActions();
        CoreWeaponRules = ruledb.GetCoreWeaponRules();
        UniversalEquipment = ruledb.GetUniversalEquipment().Cast<Rule>().ToArray();
        CoreDefinitions = [
            ruledb.GetValue("activation")!,
            ruledb.GetValue("counteract")!,
            ruledb.GetValue("control-range")!,
            ruledb.GetValue("visible")!,
            ruledb.GetValue("valid-target")!,

            ruledb.GetValue("conceal")!,
            ruledb.GetValue("engage")!,
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender) {
            await js.InvokeVoidAsync("preventTabbing", descriptionTextArea);
        }
    }

    private async Task loadpkg(InputFileChangeEventArgs e) {
        try {
            using var remote = e.File.OpenReadStream();

            // Copy the file into local memory
            using MemoryStream local = new MemoryStream();
            await remote.CopyToAsync(local);
            local.Position = 0;

            this.pkg = Kt.Data.IO.Pkg.FromFile(local);
        } catch {
            await prompt.AlertAsync("Failed to import package, the package may be malformed.");
        }
    }

    private string? name {
        get => selectedObject?.Name;
        set {
            selectedObject?.Name = value;
            //Never update ID
            //selectedObject?.Id = value is null ? null : whitespace.Replace(value.Trim().ToLower(), "-");
        }
    }

    private string? description {
        get => selectedObject?.Description;
        set => selectedObject?.Description = value;
    }

    private async Task descriptionListen(KeyboardEventArgs args) {
        if (args.CtrlKey) {
            switch (args.Code) {
                case "KeyB":
                    await surroundSelectionDescription("<b>","</b>");
                    break;
                case "KeyI":
                    await surroundSelectionDescription("<i>","</i>");
                    break;
                case "KeyU":
                    await surroundSelectionDescription("<u>","</u>");
                    break;
            }
        }

        if (args.Code == "Tab") {
            await insertIntoDescription("    ");
        }
    }

    private IEnumerable<Rule> DefinitionsAndActions {
        get {
            return 
                (pkg.Definitions?.Values?.Cast<Rule>() ?? Enumerable.Empty<Rule>())
                .Concat(pkg.Actions?.Values?.Cast<Rule>() ?? Enumerable.Empty<Rule>());
        }
    }

    private struct CaretPosition {
        public int start {get; set;}
        public int end {get; set;}
    }
    private async Task surroundSelectionDescription(string before, string after) {
        if (selectedObject is null)
            return;

        var desc = this.description ?? string.Empty;

        var caret = await js.InvokeAsync<CaretPosition>("getCaretPosition", descriptionTextArea);
        
        int start = Math.Clamp(caret.start, 0, desc.Length);
        int end = Math.Clamp(caret.end, start, desc.Length);

        desc = 
            desc[..start] +
            before +
            desc[start..end] +
            after +
            desc[end..];
        this.description = desc;
        return;
    }
    private async Task insertIntoDescription(string text) {
        if (selectedObject is null)
            return;

        var desc = description;
        if (desc is null) {
            desc = string.Empty;
            description = desc;
        }

        var caret = await js.InvokeAsync<CaretPosition>("getCaretPosition", descriptionTextArea);
        if (caret.start >= desc.Length) {
            description = desc + text;
            return;
        }

        description = desc.Insert(caret.start, text);
        return;
    }

    private bool IsSelected(object? self) {
        return ReferenceEquals(self, selectedObject);
    }

    private static readonly Regex whitespace = new Regex(@"\s+", RegexOptions.Compiled);
    private async Task<T?> Add<T>() where T:IPackagedContent, new() {
        var name = await prompt.PromptAsync<string>("Item Name?", string.Empty);
        if (string.IsNullOrEmpty(name))
            return default(T);
        
        T val = new();
        val.Name = name;
        val.Id = whitespace.Replace(((pkg.Name ?? "new-package") + "-"  + typeof(T).Name + "-" + name).Trim().ToLower(), "-");

        foreach (var prop in pkgType.GetProperties(BindingFlags.Public | BindingFlags.Instance)) {
            if (prop.PropertyType.IsAssignableTo(typeof(Dictionary<string, T>))) {
                Dictionary<string, T>? dict = prop.GetValue(pkg) as Dictionary<string, T>;
                if (dict is null) {
                    dict = new Dictionary<string, T>();
                    prop.SetValue(pkg, dict);
                }

                dict[val.Id] = val;
                break;
            }
        }

        return val;
    }

    private void Delete(IPackagedContent content) {
        if(content is null || content.Id is null)
            return;

        pkg.Actions?.Remove(content.Id);
        pkg.Definitions?.Remove(content.Id);
        pkg.Effects?.Remove(content.Id);
        pkg.Equipment?.Remove(content.Id);
        pkg.Ploys?.Remove(content.Id);
        pkg.Teams?.Remove(content.Id);
        pkg.Units?.Remove(content.Id);

        if (ReferenceEquals(selectedObject, content))
            selectedObject = null;
    }

