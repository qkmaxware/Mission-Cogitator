<RuleAlert @ref=rules></RuleAlert>
@code {
    private RuleAlert? rules;
    private async Task alertRule(string? id) { if (string.IsNullOrEmpty(id)) return;  if(rules is null) return; await rules.Show(id); }
    private async Task alertRule(Rule r) {  if(rules is null) return; await rules.Show(r); }
}

<Modal @ref=ruleLookup Title="Search for Rule" Options=@Modal.Buttons.Cancel>
    <RuleSearch @ref=ruleSearch Items=@packageManager.LoadedContent>
       <ArticleMatch>
        <div style="cursor: pointer" @onclick=@(async () => await clickedSearchResult(context))>
            <b>@context.Name</b>
        </div>
       </ArticleMatch>
        <AmbiguousMatch>
        <div>
            <b>@context.Name (disambiguation)</b>
            <br />
            <small>@context.Name may refer to:</small>
            <ul>
                @foreach (var match in context.Articles) {
                    var self = match;
                    <li style="cursor: pointer" @onclick=@(async () => await clickedSearchResult(self))>
                        @match.Name <small><i>(@match.Id)</i></small>
                        <br />
                        @if (match.SourcePackage?.Name is not null) {
                        <small>
                            from: @match.SourcePackage.Name
                            @if (!string.IsNullOrEmpty(match.SourcePackage.Author)) {
                                <text> by @match.SourcePackage.Author</text>
                            }
                        </small>
                        }
                    </li>
                }
            </ul>
        </div>
        </AmbiguousMatch>
    </RuleSearch>
</Modal>
@code {
    private Modal? ruleLookup;
    private RuleSearch? ruleSearch;
    private async Task clickedSearchResult(Kt.Data.IO.IPackagedContent? content) {
        if (ruleLookup is null)
            return;
        await ruleLookup.Hide();

        if (content is Rule rule) {
            await alertRule(rule.Id);
        }
        else if (content is Team team) {
            select(team);
        }
        else if (content is Unit unit) {
            select(null, unit);
        }
    }
}

<Modal @ref=setupWizardModal Title="Game Setup Wizard" Options="@Modal.Buttons.None" AllowTopX=true>
    <SetupWizard @ref=setupWizard OnSetupComplete=setupWizardComplete OnSetupCancelled=cancelSetupWizard></SetupWizard>
</Modal>
<Modal @ref=addUnitToDeploymentModal Title="Deploy Unit" Options=@Modal.Buttons.OkayCancel OnOkay="addUnitToTeam">
    <label>Team:</label>
    <select class="w3-select" value="@addFromTeamId" @onchange=selectTeamToAddFrom>
        <option></option>
        @foreach (var grp in teamdb.AllTeamsGrouped) {
            <optgroup label=@grp.Key>
                @foreach (var team in grp) {
                    <option value="@team.Id">@team.Name</option>
                }
            </optgroup>
        }
    </select>
    <label>Unit:</label>
    <select class="w3-select" value="@addUnitId" @onchange=selectUnitToAdd>
        <option></option>
        @foreach (var unit in (addFromTeam?.Units ?? Enumerable.Empty<Unit>())) {
            <option value="@unit.Id">@unit.Name</option>
        }
    </select>
    <label>Amount to Add:</label>
    <input type="number" class="w3-input" @bind=addAmt/>
</Modal>
<Modal @ref=addEqToDeploymentModal Title="Deploy Equipment" Options=@Modal.Buttons.OkayCancel OnOkay="addEqToTeam">
    <label>Equipment:</label>
    <select class="w3-select" value="@addEqId" @onchange=@((v) => addEqId = v.Value?.ToString() ?? string.Empty)>
        <option></option>
        @foreach (var eqgrp in (ruledb.AllEquipment ?? Enumerable.Empty<Equipment>()).GroupBy(x => x.SourcePackage?.Name)) {
            <optgroup label="@eqgrp.Key">
                @foreach (var eq in eqgrp) {
                <option value="@eq.Id">@eq.Name</option>
                }
            </optgroup>
        }
    </select>
</Modal>
@code {
    private string? addFromTeamId;
    private Team? addFromTeam;
    private void selectTeamToAddFrom(ChangeEventArgs e) {
        Team? team = teamdb.GetValue(e.Value?.ToString() ?? string.Empty);
        addFromTeamId = team?.Id;
        addFromTeam = team;
    }
    private string? addUnitId;
    private Unit? addUnit;
    private void selectUnitToAdd(ChangeEventArgs e) {
        if (addFromTeam is null || addFromTeam.Units is null)
            return;
        
        var id = e.Value?.ToString() ?? string.Empty;
        var unit = addFromTeam.Units.Where(x => id == x.Id).FirstOrDefault();
        addUnitId = unit?.Id;
        addUnit = unit;
    }
    private int _addAmt;
    private int addAmt {
        get => Math.Max(1, _addAmt);
        set => _addAmt = Math.Max(1, value);
    }
    private Modal? addUnitToDeploymentModal;
    private async Task showAddUnitModal() {
        addFromTeamId = null;
        addFromTeam = null;
        addUnitId = null;
        addUnit = null;
        if (addUnitToDeploymentModal is null)
            return;
        await addUnitToDeploymentModal.Show();
    }
    private void addUnitToTeam() {
        if (addFromTeam is null)
            return;
        if (addUnit is null)
            return;
        
        for (var i = 0; i < addAmt; i++)
            deployment.Units.Add(new DeployedUnit(addFromTeam, addUnit));
    }

    private Modal? addEqToDeploymentModal;
    private string? addEqId = null;
    private async Task showAddEqModal() {
        addEqId = null;
         if (addEqToDeploymentModal is null)
            return;
        await addEqToDeploymentModal.Show();
    }
    private void addEqToTeam() {
        if (string.IsNullOrEmpty(addEqId))
            return;

        var rule = ruledb.GetValue(addEqId);
        if (rule is not Equipment eq)
            return;

        deployment.Equipment.Add(eq);
    }

    private Modal? setupWizardModal {get; set;}
    private SetupWizard? setupWizard {get; set;}
    public async Task openSetupWizard() {
        if (setupWizard is not null)
            await setupWizard.Restart();
        setupWizardModal?.OpenNavMenu();
    } 
    public async Task cancelSetupWizard() {
        setupWizardModal?.CloseNavMenu();
        await InvokeAsync(StateHasChanged);
    }
    public async Task setupWizardComplete(Deployment deployment) {
        this.deployment = deployment ?? this.deployment;
        if (counters is not null) {
            await counters.Reinit();
        }
        setupWizardModal?.CloseNavMenu();
        await InvokeAsync(StateHasChanged);
    }
}

