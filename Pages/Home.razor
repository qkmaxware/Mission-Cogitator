<article>
    @switch (currentTab) {
        case Tab.QuickReference:
        <QuickReference OnRuleLookup="alertRule"></QuickReference>
        break;
        case Tab.UnitTab:
        <UnitRenderer Team=@selectedTeam Deployment=@selectedDeployment OnWeaponRuleLookup=@(async(ruleId) => await alertRule(ruleId)) OnRuleLookup=@(async(rule) => await alertRule(rule)) OnTeamLookup=@((team) => select(team))></UnitRenderer>
        break;
        case Tab.TeamTab:
        <TeamRenderer Team=@selectedTeam OnRuleLookup=@(async(ruleId) => await alertRule(ruleId)) OnUnitLookup=@(async (x) => { select(x.Item1, x.Item2); await InvokeAsync(StateHasChanged); })></TeamRenderer>
