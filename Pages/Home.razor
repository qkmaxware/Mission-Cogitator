<Modal @ref=importPackageModal Title="Load User Package" Options=@Modal.Buttons.OkayCancel OnCancel=cancelPkg OnOkay=confirmPkg>
    <label>Upload Package ZIP:</label>
    <div class="w3-padding w3-center">
        <InputFile OnChange="importUserPackage" accept=".zip"/>
    </div>
    <br />
    @if (userPkgException is not null) {
    <div class="app-error w3-leftbar w3-container">
        <label><b>Error:</b></label>
        <p>
            <pre>@userPkgException</pre>
        </p>
    </div>
    }
    @if (userPkg is not null) {
    <div class="w3-leftbar w3-container">
        <label><b>@userPkg.Name</b> by <i>@userPkg.Author</i> provides:</label>
        <p class="comma-separated">
            @foreach (var asset in userPkg.Provides()) {
                <span>@asset.Id</span>
            }
        </p>
    </div>
    }
</Modal>
@code {
    private Modal? importPackageModal;
    private async Task showImportPackageModal() {
        if (importPackageModal is null)
            return;
        await importPackageModal.Show();
    }
    private Kt.Data.IO.Pkg? userPkg = null;
    private Exception? userPkgException = null;
    private async Task importUserPackage(InputFileChangeEventArgs e) {
        await cancelPkg();

        using var remote = e.File.OpenReadStream();

        // Copy the file into local memory
        using MemoryStream local = new MemoryStream();
        await remote.CopyToAsync(local);
        local.Position = 0;

        try {
            this.userPkg = Kt.Data.IO.Pkg.FromFile(local);
        } catch (Exception ex) {
            userPkgException = ex;
        }
    }
    private async Task cancelPkg() {
        userPkg = null;
        userPkgException = null;
    }
    private async Task confirmPkg() {
        packageManager.Import(userPkg);
        userPkgException = null;
    }
}

