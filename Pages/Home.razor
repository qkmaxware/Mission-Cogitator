<Counters></Counters>

<article class="w3-padding">
    <UnitRenderer Team=@selectedTeam Deployment=@selectedDeployment OnWeaponRuleLookup=@(async(ruleId) => await alertRule(ruleId)) OnRuleLookup=@(async(rule) => await alertRule(rule))></UnitRenderer>
    @code {
        private Team? selectedTeam;
        private DeployedUnit? selectedDeployment;
    }
</article>


@code {
    private Deployment deployment = new ();


    private void select(DeployedUnit deployment) {
        this.selectedTeam = deployment.Team;
        this.selectedDeployment = deployment;
        if (deployment.Unit is null)
            return;
        this.navigator?.CloseNavMenu();
    }
    private void select(Team? team, Unit? unit) {
        if (unit is null)
            return;

        this.selectedTeam = team;
        this.selectedDeployment = new DeployedUnit(team, unit);
        this.navigator?.CloseNavMenu();
    }

    private void LoadCustomTeam() {

    }

    private async Task serializeDeployment() {
        // Create deployment specification
        SerializedDeployment dep = new SerializedDeployment();
        dep.Units = deployment.Units.GroupBy(u => u.Team?.Id ?? string.Empty).ToDictionary(grp => grp.Key, grp => grp.Select(u => u.Unit?.Id ?? string.Empty).ToArray());

        // Download the deployment
        using var stream = new MemoryStream();
        await JsonSerializer.SerializeAsync(stream, dep, options: Kt.Data.IO.Pkg.SerializationOptions);
        stream.Position = 0;

        using var streamRef = new DotNetStreamReference(stream);
        await js.InvokeVoidAsync("downloadFileFromStream", "deployment.json", streamRef);
    }

    private async Task deserializeDeployment(InputFileChangeEventArgs e) {
        using var stream = e.File.OpenReadStream();

        // Read depoyment specification
        SerializedDeployment? spec = null;
        try {
            spec = await JsonSerializer.DeserializeAsync<SerializedDeployment>(stream, options:  Kt.Data.IO.Pkg.SerializationOptions);
        } catch {
            return;
        }
        if (spec is null) {
            return;
        }
        
        // Replace deployment
        deployment.Units.Clear();
        if (spec.Units is not null) {
            foreach (var kv in spec.Units) {
                var team = teamdb.GetValue(kv.Key);
                if (team is null || team.Units is null)
                    continue;

                if (kv.Value is null)
                    continue;
                
                foreach (var unitId in kv.Value) {
                    if (string.IsNullOrEmpty(unitId))
                        continue;
                    
                    var unit = team.Units.Where(u => unitId == u.Id).FirstOrDefault();
                    if (unit is null)
                        continue;

                    deployment.Units.Add(new DeployedUnit(team, unit));
                }
            }
        }

        if (importDeploymentModal is not null)
            await importDeploymentModal.Hide();
    }
}