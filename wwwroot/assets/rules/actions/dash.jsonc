{
    "name": "Dash",
    "ap": 1,
    "description": "Move the operative to a new position.",
    "usage": [
        "Move like a Reposition, except the operative cannot move more than 3\" or climb."
    ],
    "conditions": [
        "An operative cannot perform this action while within <see cref='control-range'>control range</see> of an enemy operative, or during the same activation as the <see cref='charge'>Charge</see> action."
    ]
}