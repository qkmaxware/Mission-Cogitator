@using Kt.Data
@inherits SetupWizardPage

@if (this.IsActivePage) {
<h3 style="margin-bottom: 0;">Set Up Deployment</h3>
<h4 style="margin-top: 0;">Select Your Operatives</h4>
<hr />
<div class="w3-margin-bottom">
<p>
    Select which operatives from your KT that you wish to deploy to the killzone. Please consult your KT's rules for any conditions or restrictions for your operative selection.
</p>
@if (team is null || team.Units is null) {
    <p>Something has gone wrong, please select a team first</p>
} else {
    <table class="w3-striped">
        <thead>
            <th>Available to Deploy</th>
            <th style="text-align: center;">Deployed (@selected.Count)</th>
        </thead>
        <tbody>
            @foreach (var unit in team.Units) {
                var myUnit = unit;
                <tr>
                    <td>
                        @myUnit.Name
                        @if (myUnit.SourcePackage != team.SourcePackage && myUnit.SourcePackage?.Name is not null) {
                            <br />
                            <small>
                                from: @myUnit.SourcePackage?.Name
                            </small>
                        }
                    </td>
                    <td style="text-align: center; width: 4em;">
                        <button class="w3-button app-error" @onclick=@(() => selected.Remove(myUnit))>-</button>
                        <span style="display: inline-block; padding: 8px 16px; width: 2em; text-align: center">@selected.Count(u => ReferenceEquals(u, myUnit))</span>
                        <button class="w3-button app-primary" @onclick=@(() => selected.Add(myUnit))>+</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
}

@code {
    private Team? team;

    private List<Unit> selected = new ();


    public override bool Provides(string field)
    {
        return field switch {
            "units" => true,
            _ => false
        };
    }

    public override object? GetValue(string field)
    {
        return field switch {
            "units" => selected,
            _ => false
        };
    }

    public override void Reset()
    {
        selected.Clear();
    }

    public override void OnShow()
    {
        if (Wizard is null)
            return;

        // Null case is already handled, it is safe to return a NULL default value here
        #nullable disable
        team = Wizard.GetProviderValue<Team>("team", null);
        #nullable restore
        selected.Clear();
    }

    public override bool CanAdvance()
    {
        return selected.Count > 0;
    }
}