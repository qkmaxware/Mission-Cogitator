@inherits SetupWizardPage

@if (this.IsActivePage) {
<h3 style="margin-bottom: 0;">Set Up the Battle</h3>
<h4 style="margin-top: 0;">Determine the Killzone</h4>
<hr />
<div class="w3-margin-bottom">
<p>
    Determine the area of play to be used as the killzone.
</p>
<p>
    The ideal size for the killzone is:
    <ul>
        <li>22" x 30"</li>
    </ul>
</p>
<p>
    Once an area has been set aside, place all terrain onto the zone. Follow official terrain positioning if required.
</p>
</div>
}

@code {
    private string? team;

    public override void Reset()
    {
        
    }

    public override bool CanAdvance()
    {
        return true;
    }
}