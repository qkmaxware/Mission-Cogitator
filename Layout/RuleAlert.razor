@using System.Text.RegularExpressions
@using System.Xml.Linq
@using Kt.Data
@using Microsoft.AspNetCore.Components.Rendering
@using HtmlAgilityPack

@inject Data.RuleDatabase rules

<div class="w3-modal @MenuCssClass">
    <div class="w3-modal-content w3-round-large">
        <header class="w3-container w3-display-container app-primary"> 
            <table>
                <tbody>
                    <tr>
                        @switch (Rule) {
                            case Kt.Data.Action action:
                                <td class="w3-hide-small header-icon-col">
                                    <img src="art/action.svg" class="header-icon"/>
                                </td>
                                break;
                            case Kt.Data.Effect effect:
                                <td class="w3-hide-small header-icon-col">
                                    <img src="art/effect.svg" class="header-icon"/>
                                </td>
                                break;
                            case Kt.Data.Ploy ploy:
                                <td class="w3-hide-small header-icon-col">
                                @switch (ploy.Kind) {
                                    case PloyKind.strategy:
                                        <img src="art/strategy-inverted.svg" class="header-icon"/>
                                        break;
                                    case PloyKind.firefight:
                                        <img src="art/ranged-inverted.svg" class="header-icon"/>
                                        break;
                                }
                                </td>
                                break;
                            case Kt.Data.Equipment equipment:
                                <td class="w3-hide-small header-icon-col">
                                    <img src="art/gears.svg" class="header-icon"/>
                                </td>
                                break;
                            default:
                                <td class="w3-hide-small header-icon-col">
                                    <img src="art/rule.svg" class="header-icon"/>
                                </td>
                                break;
                        }
                        <td>
                            <h2>@Rule?.Name</h2>
                            @if (Rule?.SourcePackage is not null) {
                                <h5 style="white-space: wrap;">
                                    @Rule.SourcePackage.Name 
                                    @if(Rule.SourcePackage.Updated is not null){ <text> (@Rule.SourcePackage.Updated)</text> }
                                </h5>
                            }
                        </td>
                        <td style="text-align: right;">
                            @if(Rule is Kt.Data.Action act){
                                <span class="w3-xlarge w3-margin-right">@act.Ap AP</span>
                            }
                            else if (Rule is Kt.Data.Ploy ploy) {
                                <span class="w3-xlarge w3-margin-right">@ploy.CP() CP</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </header>
        <article class="w3-padding w3-large">
            @RenderDescription(Rule?.Fmt())
        </article>
        <figure class="w3-center">
            @if (Rule?.ArtPath is not null) {
                <img src="@Rule?.ArtPath" style="max-width: 80%;"/>
            }
            <figcaption>@Rule?.ArtCaption</figcaption>
        </figure>
        <footer class="w3-padding w3-center">
            <button class="w3-button app-primary w3-round" style="width: 80%;" @onclick=CloseNavMenu>Okay</button>
        </footer>
    </div>
</div>

@code {
    private static Rule NoRule = new Rule{
        Name = "No Rule Found",
        Description = "Nothing could be found for this rule"
    };

    private Rule? Rule { get; set; } = NoRule;

    private bool collapseMenu = true;

    private string? MenuCssClass => collapseMenu ? "w3-hide" : "w3-show";

    public async Task Show(Rule rule) {
        collapseMenu = false;
        this.Rule = rule;
        await InvokeAsync(StateHasChanged);
    }

    public async Task Show(string ruleId) {
        collapseMenu = false;
        var rule = rules.GetValue(ruleId);
        this.Rule = rule ?? NoRule;
        await InvokeAsync(StateHasChanged);
    }

    public void ToggleNavMenu()
    {
        collapseMenu = !collapseMenu;
        StateHasChanged();
    }
    public void CloseNavMenu() {
        collapseMenu = true;
        StateHasChanged();
    }
    public void OpenNavMenu() {
        collapseMenu = false;
        StateHasChanged();
    }

    private RenderFragment RenderDescription(string? text) => builder =>
    {
        DescriptionRenderer.RenderDescription(text, this, async (id) => await Show(id))(builder);
    };
}