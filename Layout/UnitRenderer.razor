@using Kt.Data

@inject RuleDatabase ruledb
@inject IJSRuntime js

<Modal @ref=diceModal Title="Attack Roll" Options=@Modal.Buttons.Okay>
    <DiceShelf @ref=dice></DiceShelf>
</Modal>

<Modal @ref="addEffectModal" Title="Add Effect/Status" Options=@Modal.Buttons.OkayCancel OnOkay=addSelectedEffect>
    <label>Effect:</label>
    <select class="w3-select" @bind=selectedEffectId>
        <option></option>
        @foreach (var effect in ruledb.AllEffects) {
            <option value="@effect.Id">@effect.Name</option>
        }
    </select>
</Modal>

@if (Unit is not null) {

<div>
    <header class="w3-row">
        <h1 class="unit-name w3-half">
            <span class="border-primary">@Unit.Name</span>
            @if (!string.IsNullOrEmpty(Unit.ArtPath)) {
                <img src="@Unit.ArtPath"/>
            }
        </h1>
        <div class="w3-half w3-row attributes">
            <div class="w3-col s3 w3-center">
                <span>APL</span>
                <div>
                    <img src="art/apl.svg" style="height: 1em"/> @(Unit.Attributes?.Apl)
                </div>
            </div>
            <div class="w3-col s3 w3-center">
                <span>MOVE</span>
                <div>
                    <img src="art/move.svg" style="height: 1em"/> @(Unit.Attributes?.Move)"
                </div>
            </div>
            <div class="w3-col s3 w3-center">
                <span>SAVE</span>
                <div>
                    <img src="art/save.svg" style="height: 1em"/> @(Unit.Attributes?.Save)+
                </div>
            </div>
            <div class="w3-col s3 w3-center">
                <span>WOUND</span>
                <div class="clickable" @onclick=applyDamage>
                    <img src="art/wound.svg" style="height: 1em"/> @(Deployment?.CurrentWounds ?? 0)/@(Unit.Attributes?.Wounds)
                </div>
            </div>
        </div>
    </header>
    <article class="w3-padding w3-large">
        <div class="horizontal-gallery border-primary w3-border-bottom w3-margin-bottom">
            <button class="w3-button w3-round gallery-item" title="Add Effect" @onclick=beginAddStatus>
                <img src="art/marker-add.svg"/>
            </button>
            @if (Deployment?.Effects is not null) {
                @foreach (var effect in Deployment.Effects) {
                    var myEffect = effect;
                    var effectId = myEffect.Id;
                    <button class="w3-button w3-round gallery-item" title="@effectId" @onclick=@(async() => await OnWeaponRuleLookup.InvokeAsync(effectId)) @oncontextmenu=@(() => rm(myEffect)) @oncontextmenu:preventDefault @ondblclick=@(() => rm(myEffect))>
                        <img src="@(string.IsNullOrEmpty(effect.ArtPath) ? "art/unknown-full.svg" : effect.ArtPath)"/>
                    </button>
                }
            }
        </div>
        <table class="border-primary">
            <thead >
                <th class="border-primary">NAME</th>
                <th class="border-primary">ATK</th>
                <th class="border-primary">HIT</th>
                <th class="border-primary">DMG</th>
            </thead>
            <tbody>
                @foreach (var weapon in (Unit.Weapons ?? Enumerable.Empty<Weapon>()) ) {
                    var myWeapon = weapon;
                    <tr class="border-primary">
                        <td>
                            <div>
                                <img src="@weaponImg(myWeapon.Kind)" style="height: 1.5em; padding-right: 1em;"/> 
                                @myWeapon.Name
                            </div>
                            <div class="comma-separated">
                                @foreach (var rule in (myWeapon.Rules ?? Enumerable.Empty<WeaponRule>())) {
                                    var ruleId = rule.Id;
                                    <a href="#" @onclick=@(async() => await OnWeaponRuleLookup.InvokeAsync(ruleId))>@rule @if(rule.X > 0) { <text>-@rule.X</text> }</a>
                                }
                            </div>
                        </td>
                        <td class="w3-center clickable" @onclick=@(() => attackRoll(myWeapon))>@myWeapon.Atk</td>
                        <td class="w3-center">@(myWeapon.Hit)+</td>
                        <td class="w3-center">@(myWeapon.Damage?.Normal)/@(myWeapon.Damage?.Critical)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="w3-row-padding">
            <div class="w3-half">
                @RenderDescription(Unit.Description)
            </div>
            <div class="w3-half">
                @foreach (var frule in (Unit.Rules ?? Enumerable.Empty<string>())) {
                    var ruleId = frule;
                    Rule? ruleInstance = null; 
                    if (Team is not null && Team.Rules is not null) {
                        Team.Rules.TryGetValue(ruleId, out ruleInstance);
                    }
                    <button class="w3-button app-primary w3-margin-bottom" style="width: 100%" @onclick=@(() => lookupFactionRule(ruleId))>
                        @(ruleInstance?.Name ?? frule)
                        @if (ruleInstance is Kt.Data.Action act) {
                            <span style="float: right">@act.Ap AP</span>
                        }
                    </button>
                }
            </div>
        </div>
    </article>
    <footer class="w3-padding w3-large">
        <div class="comma-separated">
            @if (Team is not null) {
                <span class="text-primary">@Team.Name</span>
            }
            @foreach (var tag in (Unit.Tags ?? Enumerable.Empty<string>())) {
                <span>@tag</span>
            }
        </div>
    </footer>
</div>

}

@code {
    [Parameter] public Team? Team {get; set;}
    private Unit? Unit => Deployment?.Unit;
    [Parameter] public DeployedUnit? Deployment {get; set;}

    [Parameter]
    public EventCallback<string> OnWeaponRuleLookup { get; set; } 

    [Parameter]
    public EventCallback<Rule> OnRuleLookup { get; set; } 

    private Modal? diceModal;
    private DiceShelf? dice;
    private Modal? addEffectModal;

    private async Task lookupFactionRule(string id) {
        if (Team is null || Team.Rules is null)
            return;
        
        Team.Rules.TryGetValue(id, out var ruleInstance);

        if (ruleInstance is not null)
            await OnRuleLookup.InvokeAsync(ruleInstance);
    }

    private string weaponImg(WeaponKind kind) {
        return kind switch {
            WeaponKind.ranged => "art/ranged.svg",
            WeaponKind.melee => "art/melee.svg",
            _ => "art/unknown.svg"
        };
    }

    private void attackRoll(Weapon weapon) {
        dice?.SetCount(weapon.Atk, weapon.Hit);
        diceModal?.Show();
        dice?.RollAll();
    }

    private RenderFragment RenderDescription(string? text) => builder =>
    {
        DescriptionRenderer.RenderDescription(text, this, async (id) => {
            await OnWeaponRuleLookup.InvokeAsync(id);
        })(builder);
    };

    private async Task applyDamage() {
        var input = await js.InvokeAsync<string>("prompt", "Amount of wounds to apply", "1");
        if (int.TryParse(input, out var num) && Deployment is not null) {
            Deployment.CurrentWounds += num;
        }
    }   

    private string? selectedEffectId;
    private async Task beginAddStatus() {
        selectedEffectId = null;
        if (this.addEffectModal is not null)
            await this.addEffectModal.Show();
    }

    private async Task addSelectedEffect() {
        if (string.IsNullOrEmpty(selectedEffectId))
            return;

        if (Deployment is null)
            return;

        if (Deployment.Effects is null)
            Deployment.Effects = new List<Effect>();
            
        Rule? maybeEffect = await ruledb.GetValue(selectedEffectId);
        if (maybeEffect is null || maybeEffect is not Effect effect)
            return;

        Deployment.Effects.Add(effect);
    }

    private void rm(Effect effect) {
        if (Deployment is null || Deployment.Effects is null)
            return;

        Deployment.Effects.Remove(effect);
    }
}