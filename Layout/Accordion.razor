<div class="accordion">
    <button class="w3-button w3-bar-item" @onclick="ToggleNavMenu">
        @Title @if(collapseMenu) {
            <span class="chevron down invert-dark"></span>
        } else {
            <span class="chevron up invert-dark"></span>
        }
        @if (!string.IsNullOrEmpty(Subtitle)) {
            <br />
            <small><i>@Subtitle</i></small>
        }
    </button>
    <div class="accordion-content w3-border-light-grey @MenuCssClass" style="min-height: 1em;">
    @ChildContent
    </div>
</div>

@code {
    [Parameter] public bool InitiallyExpand {get; set;}
    [Parameter] public string? Title {get; set;}
    [Parameter] public string? Subtitle {get; set;}

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool collapseMenu = true;

    private string? MenuCssClass => collapseMenu ? "w3-hide" : "w3-show";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        this.collapseMenu = !InitiallyExpand;
    }

    public void ToggleNavMenu()
    {
        collapseMenu = !collapseMenu;
        StateHasChanged();
    }
    public void CloseNavMenu() {
        collapseMenu = true;
        StateHasChanged();
    }
    public void OpenNavMenu() {
        collapseMenu = false;
        StateHasChanged();
    }
}