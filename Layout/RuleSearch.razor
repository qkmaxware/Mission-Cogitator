@implements IDisposable

@using System.Collections.Generic
@using System.Timers
@using Kt.Data
@using Kt.Data.IO

@inject IJSRuntime js

<div class="w3-display-container">
    <img src="art/search.svg" draggable="false" class="w3-display-left invert-dark"/>
    <input @ref=input type="text" class="w3-input search" placeholder="@_placeholder" @bind=text @bind:event="oninput">
</div>
<ul class="results">
    @if (this.results != null) {
        foreach (var matches in this.results) {
            if (matches.Articles.Count == 1) {
                if (ArticleMatch is not null) {
                <li>@ArticleMatch(matches.Articles[0])</li>
                }
            }
            else if (matches.Articles.Count > 1) {
                if (AmbiguousMatch is not null) {
                <li>@AmbiguousMatch(matches)</li>
                }
            }
        }
    }
</ul>

@code {
    [Parameter] public float DebounceTime {get; set;} = 0.5f;
    [Parameter] public string? Placeholder {get; set;}
    [Parameter] public IEnumerable<IPackagedContent>? Items {get; set;}
    [Parameter] public RenderFragment<IPackagedContent>? ArticleMatch {get; set;}
    [Parameter] public RenderFragment<Ambiguity>? AmbiguousMatch {get; set;}
    [Parameter] public Func<string, string, bool>? Comparator {get; set;} 

    private ElementReference? input;

    private string _placeholder => Placeholder ?? "search";
    private string? _text;
    private string? text {
        get => _text;
        set {
            _text = value;
            StartSearch();
        }
    }

    public async Task Focus() {
        if (input is null)
            return;
        await Task.Yield();
        await input.Value.FocusAsync(preventScroll: true);
    }

    private Timer? timer;
    public void StartSearch() {
        if (timer == null) {
            timer = new Timer();
            timer.AutoReset = false;
            timer.Interval = TimeSpan.FromSeconds(DebounceTime).TotalMilliseconds;
            timer.Elapsed += refreshResults;
        }
        timer.Stop();
        timer.Start();
    }

    public void Dispose() {
        timer?.Dispose();
    }

    public struct Ambiguity {
        public string Name {get; init;}
        public IReadOnlyList<IPackagedContent> Articles {get; set;}

        public bool IsAmbiguous {
            get => this.Articles.Count > 1;
        }

        public Ambiguity(string name, IReadOnlyList<IPackagedContent> articles) {
            this.Name = name;
            this.Articles = articles;
        }
    }

    private List<Ambiguity>? results;
    private bool defaultComparator (string text, string item) {
        return System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(
            item?.ToString() ?? string.Empty, 
            text, 
            System.Globalization.CompareOptions.IgnoreCase
        ) >= 0;
    }
    private bool matchesSearch(string? searchTerm, IPackagedContent? content, Func<string, string, bool> textComparer) {
        if (content?.Name is null || searchTerm is null)
            return false;

        if (textComparer(searchTerm, content.Name))
            return true;

        if (content.Tags is not null && content.Tags.Count > 0) {
            foreach (var tag in content.Tags) {
                if (string.IsNullOrEmpty(tag))
                    continue;
                if (textComparer(searchTerm, tag))
                    return true;
            }
        }

        return false;
    }
    private void refreshResults(object? sender, ElapsedEventArgs e) {
        this.results = null;
        var term = this.text ?? string.Empty;
        if (string.IsNullOrEmpty(term)) {
            InvokeAsync(StateHasChanged);
            return;
        }
        var compare = this.Comparator ?? defaultComparator;
        Task.Run(() => {
            if (Items == null) {
                return;
            }

            List<Ambiguity> results = Items
                    .Where(pkg => matchesSearch(term, pkg, compare))
                    .GroupBy(x => x.Name)
                    .Select(x => new Ambiguity(
                        x.Key ?? string.Empty, 
                        x.ToList().AsReadOnly()
                    ))
                    .ToList();
            if (term == this.text) {
                this.results = results;
                InvokeAsync(StateHasChanged);
            }
        });
    }

}
