<div class="w3-row w3-light-grey">
    <div class="w3-half w3-padding">
        <label><img src="art/tp.svg"/>TURNING POINT:</label>
        <div class="turning-points w3-row">
            <button class="w3-button text-primary w3-col" @onclick=decTp>
                <img class="icon" src="art/chevron-left.svg"/>
            </button>
            <button class="w3-button text-primary w3-col w3-right" @onclick=incTP>
                <img class="icon" src="art/chevron-right.svg"/>
            </button>
            <div class="w3-rest">
                <input type="number" class="w3-input" @bind=TurningPoint/>
            </div>
        </div>
    </div>
    <div class="w3-half w3-row">
        <div class="command-points w3-col s4 w3-padding">
            <label><img src="art/cp.svg"/>CP:</label>
            <input type="number" class="w3-input" @bind=CommandPoints/>
        </div>
        <div class="victory-points w3-col s4 w3-padding">
            <label><img src="art/victory.svg"/>VP:</label>
            <input type="number" class="w3-input" @bind=VictoryPoints/>
        </div>
        <div class="other-points w3-col s4 w3-padding">
            <label><img src="art/unknown.svg"/>OTHER:</label>
            <input type="number" class="w3-input" @bind=GenericCounter/>
        </div>
    </div>
</div>

@code {

    private int tp = 1;
    private int cp = 2;
    private int vp = 0;
    private int gc = 0;

    public int TurningPoint {
        get => tp;
        set => tp = Math.Max(1, value);
    }
    public int CommandPoints {
        get => cp;
        set => cp = Math.Max(0, value);
    }
    public int VictoryPoints {
        get => vp;
        set => vp = Math.Max(0, value);
    }
    public int GenericCounter {
        get => gc;
        set => gc = Math.Max(0, value);
    }

    public async Task Reinit() {
        this.TurningPoint = 1;
        this.CommandPoints = 2;
        this.VictoryPoints = 0;
        this.GenericCounter = 0;
        await InvokeAsync(StateHasChanged);
    }

    private void incTP() {
        TurningPoint = TurningPoint + 1;
    }
    private void decTp() {
        TurningPoint = TurningPoint - 1;
    }
}