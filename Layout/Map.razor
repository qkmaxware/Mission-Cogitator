@using System.Drawing
<svg viewBox="0 0 @MapWidth @MapHeight">
    <g id="zones">
        @if (Orientation == MapOrientation.LeftToRight) {
        <g id="left-to-right">
            <rect class="enemy" x="@MapHalfWidth" y="0" width="@MapHalfWidth" height="@MapHeight"></rect>
            <rect class="ally" x="0" y="0" width="@MapHalfWidth" height="@MapHeight"></rect>

            <rect class="enemy dropzone" x="@(MapWidth - DropZoneTallDepth)" y="0" width="@DropZoneTallDepth" height="@MapHeight"></rect>
            <rect class="ally dropzone" x="0" y="0" width="@DropZoneTallDepth" height="@MapHeight"></rect>
        </g>
        }
        @if (Orientation == MapOrientation.TopToBottom) {
        <g id="top-to-bottom">
            <rect class="enemy" x="0" y="0" width="@MapWidth" height="@MapHalfHeight"></rect>
            <rect class="ally" x="0" y="@MapHalfHeight" width="@MapWidth" height="@MapHalfHeight"></rect>

            <rect class="enemy dropzone" x="0" y="0" width="@MapWidth" height="@DropZoneWideDepth"></rect>
            <rect class="ally dropzone" x="0" y="@(MapHeight - DropZoneWideDepth)" width="@MapWidth" height="@DropZoneWideDepth"></rect>
        </g>
        }
    </g>
    <g id="grid">
        <g id="vertical">
        @for (var i = 0; i <= MapWidth; i++) {
            <line x1="@i" y1="0" x2="@i" y2="@MapHeight" />
        }
        </g>
        <g id="horizontal">
        @for (var i = 0; i <= MapHeight; i++) {
            <line x1="0" y1="@i" x2="@MapWidth" y2="@i" />
        }
        </g>
    </g>
    <g id="terrain">
        
    </g>
    <g id="markers">
        @if (ObjectiveMarkers is not null) {
            foreach (var marker in ObjectiveMarkers) {
                <image href="art/objective.svg" x="@(marker.X - 0.75f)" y="@(marker.Y - 0.75f)" width="1.5" height="1.5"/>
            }
        }
    </g>
</svg>

@code {
    private const int MapWidth = 30;
    private const int MapHalfWidth = MapWidth / 2;
    private const int MapHeight = 22;
    private const int MapHalfHeight = MapHeight / 2;

    private const int DropZoneWideDepth = 3;
    private const int DropZoneTallDepth = 3;

    [Parameter] public MapOrientation Orientation {get; set;}

    public enum MapOrientation {
        LeftToRight,
        TopToBottom,
    }

    [Parameter] public List<PointF>? ObjectiveMarkers {get; set;} = [
        new PointF(MapHalfWidth, MapHalfHeight),
        new PointF(MapHalfWidth / 2, MapHalfHeight / 2),
        new PointF(MapHalfWidth + MapHalfWidth / 2 , MapHalfHeight + MapHalfHeight / 2)
    ];
}