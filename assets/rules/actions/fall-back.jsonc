{
    "name": "Fall Back",
    "ap": 2,
    "description": "Move the operative to a new position.",
    "usage": [
        "Move like a Reposition, except the operative can move within <see cref='control-range'>control range</see> of an enemy operative, but cannot finish the move there."
    ],
    "conditions": [
        "An operative cannot perform this action unless an enemy operative is within its <see cref='control-range'>control range</see>. It cannot perform this action during the same activation as the <see cref='reposition'>Reposition</see> or <see cref='charge'>Charge</see> action."
    ]
}